# ===== 数据库 =====
# MySQL 连接串（改成本地实际账号）
DB_URL=mysql+pymysql://root:password@127.0.0.1:3306/ai_recipe
# Redis 连接（缓存菜谱基础库、食物成分表）
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 服务 =====
DEBUG=True
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# CORS 允许来源（前端联调；生产改为具体域名，如 ["http://localhost:5173"]）
CORS_ORIGINS=["*"]

# ===== 大模型（AI食谱生成，OpenAI 兼容 chat/completions）=====
# 推荐：阿里云百炼（qwen-max / qwen-plus）
# base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ===== 多模态 OCR（拍照识别食材，OpenAI 兼容 chat/completions）=====
# 推荐：百度千帆（qwen-vl-max 等视觉模型）
# base_url 与模型名以服务商控制台开通的服务为准
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=
MULTIMODAL_MODEL=

# ===== ASR 方言语音（武汉话转文字，讯飞方言大模型 WebSocket）=====
# 服务地址：讯飞"方言识别大模型"（spark_slm_iat，支持武汉话），wss 端点：
#   wss://iat.cn-huabei-1.xf-yun.com/v1
# 需要三要素（均缺一不可，否则 ASR 走 Mock 降级）：
#   APPID / APIKey / APISecret 在讯飞开放平台「我的应用-服务接口认证信息」中获取
ASR_APP_ID=
ASR_API_KEY=
ASR_API_SECRET=
ASR_BASE_URL=wss://iat.cn-huabei-1.xf-yun.com/v1